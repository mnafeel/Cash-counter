rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Website API key lookup — owner may create/update/delete own mapping; public read denied (Cloud Function uses Admin SDK).
    match /apiKeys/{keyHash} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if false;
    }

    // Public export snapshot keyed by SHA-256(apiKey). Readable without auth (Spark-compatible).
    // Security relies on the unguessable key hash; disable API to remove/stop updating this doc.
    match /websiteApiExports/{keyHash} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['body', 'exportedAt', 'storeId', 'enabled'])
        && request.resource.data.storeId == request.auth.uid
        && request.resource.data.enabled is bool
        && request.resource.data.body is string;
      allow delete: if request.auth != null
        && resource.data.storeId == request.auth.uid;
    }
  }
}
